# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka.example.com:9094
KAFKA_TOPIC=healthcheck-heartbeat
KAFKA_GROUP_ID=healthcheck-monitor
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_SECURITY_PROTOCOL=SASL_SSL
# Broker 설정에 맞게 PLAIN, SCRAM-SHA-256, SCRAM-SHA-512 중 선택
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=replace-me
KAFKA_SASL_PASSWORD=replace-me
# 사설 CA를 쓰는 경우 인증서 파일 경로를 지정. 공인 CA라면 비워둡니다.
KAFKA_SSL_CA_LOCATION=

# Oracle MES equipment status cache
ORACLE_DSN=oracle.example.com:1521/service-name
ORACLE_USER=replace-me
ORACLE_PASSWORD=replace-me
# 반드시 첫 컬럼 EQP_ID, 두 번째 컬럼 MAIN_STAT_CD를 반환하도록 작성합니다.
ORACLE_STATUS_QUERY=select eqp_id, main_stat_cd from REPLACE_WITH_STATUS_TABLE
ORACLE_REFRESH_SECONDS=30
ORACLE_CACHE_MAX_AGE_SECONDS=90
ORACLE_CALL_TIMEOUT_MS=5000
ORACLE_ALERT_STATUS_CODES=STAB,NECK

# SMTP (사내 IP 화이트리스트 기반 plain SMTP relay)
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_FROM=sender@example.com
SMTP_TO=receiver@example.com

# Notifications
MAIL_SUBJECT_PREFIX=[Kafka Heartbeat]
# 모니터링이 정하는 미수신 기준입니다. 메시지 interval은 사용하지 않습니다.
HEARTBEAT_STALE_AFTER_SECONDS=180
# poll 호출 간격이 이 값보다 길면 지연 로그를 남깁니다.
KAFKA_POLL_DELAY_GUARD_SECONDS=10
# partition별 consumer lag 로그 출력 주기
KAFKA_LAG_LOG_INTERVAL_SECONDS=60
# 시작/연결 복구 시점의 backlog 목표까지 처리한 뒤 미수신 판정을 재개합니다.
KAFKA_HEALTH_CHECK_INTERVAL_SECONDS=10
KAFKA_HEALTH_CHECK_TIMEOUT_SECONDS=3
KAFKA_HEALTH_MAX_AGE_SECONDS=30

# Persistent mail queue and retry policy
MAIL_QUEUE_POLL_SECONDS=1
MAIL_MAX_RETRY_ATTEMPTS=10
MAIL_RETRY_INITIAL_SECONDS=5
MAIL_RETRY_MAX_SECONDS=300

# PostgreSQL: 수신 상태, 관리 설정, 메일 큐를 저장합니다.
DATABASE_URL=postgresql://healthcheck:REPLACE_PASSWORD@localhost:5432/healthcheck
# API에만 필요. 추측 불가능한 24자 이상 임의 문자열로 교체하세요.
API_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS
