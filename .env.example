# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=healthcheck-heartbeat
KAFKA_GROUP_ID=heartbeat-smtp-notifier
KAFKA_AUTO_OFFSET_RESET=latest

# SMTP (example: Gmail uses smtp.gmail.com:587 with STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=sender@example.com
SMTP_TO=receiver@example.com
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# Notifications
MAIL_SUBJECT_PREFIX=[Kafka Heartbeat]
# Prevent mail storms. 0 sends every consumed message.
MAIL_MIN_INTERVAL_SECONDS=0

