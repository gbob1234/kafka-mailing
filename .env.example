# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka.example.com:9094
KAFKA_TOPIC=healthcheck-heartbeat
KAFKA_GROUP_ID=healthcheck-monitor
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_SECURITY_PROTOCOL=SASL_SSL
# Broker 설정에 맞게 PLAIN, SCRAM-SHA-256, SCRAM-SHA-512 중 선택
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=replace-me
KAFKA_SASL_PASSWORD=replace-me
# 사설 CA를 쓰는 경우 인증서 파일 경로를 지정. 공인 CA라면 비워둡니다.
KAFKA_SSL_CA_LOCATION=

# SMTP (example: Gmail uses smtp.gmail.com:587 with STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=sender@example.com
SMTP_TO=receiver@example.com
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# Notifications
MAIL_SUBJECT_PREFIX=[Kafka Heartbeat]
# 설정값과 메시지 interval*3 중 큰 값을 미수신 기준으로 사용합니다.
HEARTBEAT_STALE_AFTER_SECONDS=180
